{
  "name": "@nullagency/jam",
  "version": "0.3.0",
  "description": "Shared multi-user Claude Code sessions: rooms, roles, approvals, short invite links.",
  "type": "module",
  "bin": {
    "jam-bridge": "bridge.mjs"
  },
  "scripts": {
    "build": "./build.sh",
    "deploy": "./deploy.sh",
    "start": "./run.sh",
    "dev": "node scripts/dev.mjs",
    "test": "./check.sh",
    "test:stack": "node test-stack.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:real": "node scripts/e2e.mjs --real",
    "verify": "npm test && npm run test:stack && npm run e2e",
    "setup:e2e": "playwright install chromium"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
